# Allowlist model: ignore everything in the repo root by default, then
# explicitly re-include the configs we track. Anything new that lands in
# ~/.config (new apps, caches, tokens) is ignored automatically -- no more
# chasing it with per-app ignore lines.
#
# To start tracking something new:
#   - add a `!/name` line below, or
#   - run `git add -f <path>`

/*

# --- tracked configs (explicitly re-included) ---
!/.github/
!/.gitignore
!/LICENSE
!/README.md
!/bin/
!/cmux/
!/ghostty/
!/hammerspoon/
!/nvim/
!/zsh-abbr/
!/zshrc

# --- noise to keep out even inside tracked dirs ---
/bin/__pycache__/
