# Use zsh for new terminals in standalone Ghostty.
# NOTE: cmux ignores this — it launches the cmux process's inherited $SHELL via
# its own login wrapper. To control the shell in cmux, set the login shell
# (chsh) and/or `launchctl setenv SHELL`, then relaunch cmux.
command = /bin/zsh

# Left option sends Alt (Esc-prefix) so Alt+h/j/k/l pane navigation works in
# zsh and nvim (see bin/cmux-navigate); right option still types accents.
macos-option-as-alt = left

# Theme: match VS Code "GitHub Dark Default"
theme = GitHub Dark Default

# Override background to near-black (theme default is #0d1117)
background = #060608

# Block cursor, blinking (ghostty defaults to beam)
cursor-style = block
cursor-style-blink = true
